root = true

[*.{kt,kts}]
# @Composable functions are intentionally PascalCase; keep the rule active for
# everything else by ignoring only Composables.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose UI builds deeply nested trees; the default max line length fights it.
max_line_length = off
# The package intentionally contains an underscore (it matches the applicationId
# com.augustusmachin.android_bt_kbmouse, which must not be renamed).
ktlint_standard_package-name = disabled

# Test sources conventionally use `import org.junit.Assert.*`; allow wildcards
# there. Main source keeps no-wildcard-imports enabled (default).
[app/src/{test,androidTest}/**/*.{kt,kts}]
ktlint_standard_no-wildcard-imports = disabled
