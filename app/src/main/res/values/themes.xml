<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BluetoothKeyboardMouse" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- BlueDeck brand colors (shell theme; the Compose theme owns in-app surfaces). -->
        <item name="colorPrimary">@color/bluedeck_indigo</item>
        <item name="colorPrimaryVariant">@color/bluedeck_navy_dark</item>
        <item name="colorOnPrimary">@color/bluedeck_soft_white</item>
        <item name="colorSecondary">@color/bluedeck_teal</item>
        <item name="colorSecondaryVariant">@color/bluedeck_teal</item>
        <item name="colorOnSecondary">@color/bluedeck_navy_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Cold-start splash theme (AndroidX core-splashscreen). Hands off to the
         normal app theme as soon as the first frame is ready; no artificial delay. -->
    <style name="Theme.BlueDeck.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bluedeck_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_bluedeck</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.BluetoothKeyboardMouse</item>
    </style>
</resources>